#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt {
    quick-tap-ms = <100>;
    flavor = "balanced";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&shifted>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <1 3>;
            then-layer = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tg_qwerty {
            bindings = <&change_lang>;
            key-positions = <25 26 27>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <27 26>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <27 28>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <26 28>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <4 5>;
        };
    };

    macros {
        change_lang: change_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "CHANGE_LANG";
        };

        macos_carlique: macos_carlique {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &tog 1>;
            label = "MACOS_CARLIQUE";
        };

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&mt LEFT_META RIGHT_BRACKET  &kp Q  &kp W  &kp E      &kp R               &kp T        &kp Y        &kp U            &kp I         &kp O       &kp P     &mt LMETA LEFT_BRACKET
&mt LCTRL GRAVE              &kp A  &kp S  &kp D      &kp F               &kp G        &kp H        &kp J            &kp K         &kp L       &kp SEMI  &mt RCTRL SQT
&mt LEFT_ALT MINUS           &kp Z  &kp X  &kp C      &kp V               &kp B        &kp N        &kp M            &kp COMMA     &kp PERIOD  &kp FSLH  &mt LEFT_ALT BACKSLASH
                                           &lt 2 TAB  &mt LEFT_SHIFT ESC  &lt 3 SPACE  &lt 5 ENTER  &lt 6 BACKSPACE  &lt 7 DELETE
            >;
        };

        carlique {
            bindings = <
&mt LCTRL RIGHT_BRACKET  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mt LCTRL LEFT_BRACKET
&mt LGUI GRAVE           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mt LGUI SQT
&trans                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        media {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans             &trans        &trans        &trans           &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans  &ext_power EP_TOG  &kp C_NEXT    &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_NEXT    &trans
&sys_reset   &trans  &trans  &trans  &trans  &trans  &out OUT_TOG       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3     &bt BT_SEL 4  &bt BT_CLR
                             &trans  &trans  &trans  &kp C_STOP         &kp C_PP      &kp C_MUTE
            >;
        };

        nav {
            bindings = <
&trans  &trans    &trans    &trans     &trans           &trans  &kp K_REDO  &kp K_PASTE     &kp K_COPY     &kp K_CUT     &kp K_UNDO  &trans
&trans  &kp RGUI  &kp RALT  &kp RCTRL  &kp RIGHT_SHIFT  &trans  &kp EQUAL   &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW  &kp RIGHT   &trans
&trans  &trans    &trans    &trans     &trans           &trans  &kp INSERT  &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &trans
                            &mo 4      &trans           &trans  &kp ENTER   &kp BACKSPACE   &kp DEL
            >;
        };

        mouse {
            bindings = <
&trans  &trans         &trans        &trans     &trans          &trans  &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &trans
&trans  &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans         &trans        &trans     &trans          &trans  &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                     &trans     &trans          &trans  &mkp RCLK   &mkp LCLK       &mkp MB3
            >;
        };

        sym {
            bindings = <
&trans  &shifted LBKT   &shifted N7  &shifted N8  &shifted N9  &shifted RBKT   &trans  &trans     &trans     &trans    &trans    &trans
&trans  &shifted SEMI   &shifted N4  &shifted N5  &shifted N6  &shifted EQUAL  &trans  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &trans
&trans  &shifted GRAVE  &shifted N1  &shifted N2  &shifted N3  &shifted BSLH   &trans  &trans     &trans     &trans    &trans    &trans
                                     &shifted N9  &shifted N0  &shifted MINUS  &trans  &trans     &trans
            >;
        };

        num {
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT   &trans  &trans          &trans     &trans        &trans         &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL  &trans  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_META  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH   &trans  &trans          &trans     &trans        &trans         &trans
                           &kp DOT  &kp N0  &kp MINUS  &trans  &trans          &trans
            >;
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PRINTSCREEN  &trans  &trans          &trans     &trans        &trans         &trans
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SCROLLLOCK   &trans  &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_META  &trans
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK  &trans  &trans          &trans     &trans        &trans         &trans
                         &kp K_APP  &kp SPACE  &kp TAB          &trans  &trans          &trans
            >;
        };
    };
};
