#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt {
    quick-tap-ms = <100>;
    flavor = "balanced";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&shifted>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <4 2>;
            then-layer = <5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tg_qwerty {
            bindings = <&change_lang>;
            key-positions = <25 26 27>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <27 26>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <27 28>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <26 28>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <4 5>;
        };

        mouse_toggle {
            bindings = <&tog 3>;
            key-positions = <4 1>;
        };
    };

    macros {
        change_lang: change_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "CHANGE_LANG";
        };

        macos_carlique: macos_carlique {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &tog 1>;
            label = "MACOS_CARLIQUE";
        };

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&mt LEFT_META RIGHT_BRACKET  &kp Q  &kp W  &kp E      &kp R               &kp T        &kp Y        &kp U                      &kp I         &kp O       &kp P     &mt LMETA LEFT_BRACKET
&mt LCTRL GRAVE              &kp A  &kp S  &kp D      &kp F               &kp G        &kp H        &kp J                      &kp K         &kp L       &kp SEMI  &mt LCTRL SQT
&mt LEFT_ALT MINUS           &kp Z  &kp X  &kp C      &kp V               &kp B        &kp N        &kp M                      &kp COMMA     &kp PERIOD  &kp FSLH  &mt LEFT_ALT BACKSLASH
                                           &lt 4 TAB  &mt LEFT_SHIFT ESC  &lt 2 SPACE  &lt 2 ENTER  &mt RIGHT_SHIFT BACKSPACE  &lt 4 DELETE
            >;
        };

        carlique {
            bindings = <
&mt LCTRL RIGHT_BRACKET  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mt LCTRL LEFT_BRACKET
&mt LGUI GRAVE           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mt LGUI SQT
&trans                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &kp K_PASTE  &kp K_COPY   &kp K_CUT      &kp K_UNDO  &kp K_REDO  &as N0     &as N7        &as N8        &as N9        &trans  &trans
&trans  &kp LEFT     &kp UP       &kp DOWN       &kp RIGHT   &kp CLCK    &as EQUAL  &as NUMBER_4  &as NUMBER_5  &as NUMBER_6  &trans  &trans
&trans  &kp HOME     &kp PAGE_UP  &kp PAGE_DOWN  &kp END     &kp INS     &as MINUS  &as NUMBER_1  &as NUMBER_2  &as NUMBER_3  &trans  &trans
                                  &trans         &trans      &trans      &trans     &trans        &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &trans        &trans          &trans           &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &mkp MB4  &trans  &trans  &trans  &trans  &trans  &trans
                                      &mkp MB3        &mkp MB1         &mkp MB2  &trans  &trans  &trans
            >;
        };

        raise {
            bindings = <
&trans  &trans  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP    &kp C_NEXT      &trans  &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &trans  &ext_power EP_TOG     &kp C_MUTE         &kp C_PP        &trans  &kp SCROLLLOCK   &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &trans  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp C_PREVIOUS  &trans  &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                      &trans             &trans          &trans  &trans           &trans  &trans
            >;
        };

        bt {
            bindings = <
&bootloader  &none         &none            &none         &none         &none         &none         &none         &none         &none            &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &macos_carlique  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &macos_carlique  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none            &none         &none         &none         &none         &none         &none         &none            &none         &sys_reset
                                            &trans        &none         &trans        &none         &trans        &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
