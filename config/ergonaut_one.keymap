#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&shifted>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <4 3>;
            then-layer = <5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tg_qwerty {
            bindings = <&change_lang>;
            key-positions = <25 26 27>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <27 26>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <27 28>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <26 28>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;
        };

        close_tab {
            bindings = <&kp LC(W)>;
            key-positions = <1 0>;
        };

        close_app {
            bindings = <&kp LC(Q)>;
            key-positions = <1 2 0>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <4 5>;
        };
    };

    macros {
        change_lang: change_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 2 &kp LG(SPACE)>;
            label = "CHANGE_LANG";
        };

        komandor_password: komandozorniy_password {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp O &kp M &kp N6 &kp N8 &kp N4 &kp D &kp O &kp R &kp EXCL>;
            label = "KOMANDOZORNIY_PASSWORD";
        };

        macos_carlique: macos_carlique {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &tog 1>;
            label = "MACOS_CARLIQUE";
        };

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak {
            bindings = <
&mt LGUI RIGHT_BRACKET  &kp Q  &kp W  &kp F      &kp P                  &kp B        &kp J        &kp L                      &kp U      &kp Y    &kp SEMI  &mt LEFT_GUI LEFT_BRACKET
&mt LCTRL GRAVE         &kp A  &kp R  &kp S      &kp T                  &kp G        &kp K        &kp N                      &kp E      &kp I    &kp O     &mt RCTRL SINGLE_QUOTE
&mt LALT MINUS          &kp Z  &kp X  &kp C      &kp D                  &kp V        &kp M        &kp H                      &kp COMMA  &kp DOT  &kp FSLH  &mt RALT BSLH
                                      &lt 4 TAB  &mt LEFT_SHIFT ESCAPE  &lt 3 SPACE  &lt 3 ENTER  &mt RIGHT_SHIFT BACKSPACE  &lt 4 DEL
            >;
        };

        carlique {
            bindings = <
&mt LCTRL RIGHT_BRACKET  &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans       &mt LCTRL LEFT_BRACKET
&mt LGUI GRAVE           &mt LCTRL A  &trans  &mt S LGUI  &trans  &trans  &trans  &trans  &mt LGUI E  &trans  &mt LCTRL O  &mt LGUI SQT
&trans                   &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans       &trans
                                              &trans      &trans  &trans  &trans  &trans  &trans
            >;
        };

        qwerty {
            bindings = <
&trans  &kp Q       &kp W  &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I      &kp O       &kp P     &trans
&trans  &mt LGUI A  &kp S  &kp D   &kp F   &kp G   &kp H   &kp J   &kp K      &kp L       &kp SEMI  &trans
&trans  &kp Z       &kp X  &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp FSLH  &trans
                           &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &kp HOME      &kp PAGE_UP  &kp PAGE_DOWN  &kp END        &trans   &kp C_VOL_UP  &as N7        &as N8        &as N9        &kp C_BRIGHTNESS_INC  &kp C_NEXT
&trans  &kp LEFT      &kp UP       &kp DOWN       &kp RIGHT      &kp INS  &kp C_MUTE    &as NUMBER_4  &as NUMBER_5  &as NUMBER_6  &as N0                &mt RCTRL C_PP
&trans  &kp LG(LEFT)  &kp LG(UP)   &kp LG(DOWN)   &kp LG(RIGHT)  &trans   &kp C_VOL_DN  &as NUMBER_1  &as NUMBER_2  &as NUMBER_3  &kp C_BRIGHTNESS_DEC  &kp C_PREV
                                   &trans         &trans         &trans   &trans        &trans        &trans
            >;
        };

        raise {
            bindings = <
&trans  &trans  &kp LESS_THAN         &kp EQUAL     &kp GREATER_THAN       &trans  &trans  &kp F3  &kp F6  &kp F9  &kp F12  &trans
&trans  &trans  &kp LEFT_PARENTHESIS  &kp MINUS     &kp RIGHT_PARENTHESIS  &trans  &trans  &kp F2  &kp F5  &kp F8  &kp F11  &trans
&trans  &trans  &kp KP_MULTIPLY       &kp LS(SEMI)  &kp QUESTION           &trans  &trans  &kp F1  &kp F4  &kp F7  &kp F10  &trans
                                      &trans        &trans                 &trans  &trans  &trans  &trans
            >;
        };

        bt {
            bindings = <
&bootloader  &none         &none            &none         &none         &none         &none         &none         &none         &none            &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &macos_carlique  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &macos_carlique  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none            &none         &none         &none         &none         &none         &none         &none            &none         &sys_reset
                                            &trans        &none         &trans        &none         &trans        &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans  &kp LC(RS(Z))  &kp LC(V)  &kp LC(C)      &kp LC(X)    &kp LC(Z)  &trans
&trans  &kp LGUI  &kp LALT  &kp RCTRL  &kp RSHFT  &trans  &none          &kp LEFT   &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &trans    &trans    &trans     &trans     &trans  &none          &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp TAB
                            &trans     &trans     &trans  &mkp MB1       &mkp MB2   &mkp MB3
            >;
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans           &trans  &trans  &trans
            >;
        };
    };
};
